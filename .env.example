# Полный список переменных окружения проекта.
# .env.example лежит в репозитории и подключается в compose как база значений;
# реальные секреты — в .env (в .gitignore) или в окружении внешнего сервера.

# ───────────────────────── Общая база (все сервисы) ─────────────────────────
ALFA_PG_HOST=postgres
ALFA_PG_PORT=5432
ALFA_PG_USER=alfa
ALFA_PG_PASSWORD=alfa
ALFA_PG_DATABASE=alfa
ALFA_PG_SSLMODE=disable
ALFA_PG_MAX_CONNS=10

# ───────────────────────── go-ingest (Go #1) ─────────────────────────
INGEST_HTTP_HOST=0.0.0.0
INGEST_HTTP_PORT=8080
INGEST_HTTP_READ_HEADER_TIMEOUT=5s
INGEST_HTTP_READ_TIMEOUT=15s
# 0s = без ограничения: иначе SSE-стрим рвётся по write timeout.
INGEST_HTTP_WRITE_TIMEOUT=0s
INGEST_HTTP_IDLE_TIMEOUT=60s
INGEST_HTTP_SHUTDOWN_TIMEOUT=10s
INGEST_LOG_LEVEL=info

INGEST_POLLER_ENABLED=true
INGEST_POLLER_TICK=60s
INGEST_POLLER_MAX_ITEMS=40
INGEST_POLLER_FETCH_TIMEOUT=25s
# Если текст из ленты короче порога — дотягиваем статью со страницы новости.
INGEST_POLLER_HYDRATE_MIN_BODY_LEN=300
INGEST_POLLER_MAX_HYDRATE=15
INGEST_POLLER_USER_AGENT=AlfaHackBot/0.1 (hackathon prototype)

# ───────────────────────── llm-gateway (Go #1) ─────────────────────────
GATEWAY_HTTP_HOST=0.0.0.0
GATEWAY_HTTP_PORT=8091
GATEWAY_HTTP_READ_HEADER_TIMEOUT=5s
GATEWAY_HTTP_READ_TIMEOUT=15s
# 0s = без ограничения: вызовы моделей бывают долгими.
GATEWAY_HTTP_WRITE_TIMEOUT=0s
GATEWAY_HTTP_IDLE_TIMEOUT=60s
GATEWAY_HTTP_SHUTDOWN_TIMEOUT=10s
GATEWAY_LOG_LEVEL=info
# Внутренний токен сервисов команды. Пусто = проверка выключена (только локально).
GATEWAY_AUTH_TOKEN=

# Доступ к моделям хакатона. Ключ живёт ТОЛЬКО здесь (CLAUDE.md §12 п.1).
# Заполняется в .env, в репозиторий не попадает.
LLM_UPSTREAM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT=90s
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF=2s
LLM_MODELS_FILE=configs/llm.yaml
# Дневные лимиты в копейках. Ограничение 04 кейса: дневной лимит в денежном
# эквиваленте — 500 ₽. Soft 400 ₽ — предупреждение, hard 500 ₽ — жёсткий стоп.
LLM_SOFT_LIMIT_KOP=40000
LLM_HARD_LIMIT_KOP=50000

# ───────────────────────── go-api (Go #2) ─────────────────────────
API_HTTP_HOST=0.0.0.0
API_HTTP_PORT=8090
API_HTTP_READ_HEADER_TIMEOUT=5s
API_HTTP_READ_TIMEOUT=15s
API_HTTP_WRITE_TIMEOUT=0s
API_HTTP_IDLE_TIMEOUT=60s
API_HTTP_SHUTDOWN_TIMEOUT=10s
API_LOG_LEVEL=info
API_GATEWAY_BASE_URL=http://llm-gateway:8091
API_GATEWAY_TIMEOUT=120s
API_AGENT_BASE_URL=http://java-agent:8081
API_AGENT_TIMEOUT=120s

# ───────────────────────── py-ml (Python) ─────────────────────────
PYML_HTTP_PORT=8000
PYML_LOG_LEVEL=info
PYML_MODEL_VERSION=pyml-v0

# ───────────────────────── java-agent (Java) ─────────────────────────
AGENT_HTTP_PORT=8081
AGENT_LOG_LEVEL=info
AGENT_GATEWAY_BASE_URL=http://llm-gateway:8091
AGENT_GATEWAY_TOKEN=
AGENT_MODEL_VERSION=v0.1

# ───────────────────────── research-loader (Go #1, G1-13) ─────────────────────────
# Загрузка аналитики ЦМИ: OCR PDF-сканов → research_chunks. Файлы — make data.
RESEARCH_DIR=data/research
RESEARCH_MANIFEST=configs/research.yaml
# true — перезалить документы, даже если чанки уже в базе.
RESEARCH_FORCE=false
RESEARCH_LOG_LEVEL=info
RESEARCH_OCR_LANG=rus+eng
RESEARCH_OCR_DPI=200
# Страница распознаётся 10–30 с; параллельно идут столько страниц сразу.
RESEARCH_OCR_WORKERS=4
RESEARCH_OCR_PAGE_TIMEOUT=120s
RESEARCH_OCR_CACHE_DIR=data/research/.ocr-cache
# Чанки в символах (~3 символа на токен → 300–600 токенов).
RESEARCH_CHUNK_MIN_RUNES=900
RESEARCH_CHUNK_TARGET_RUNES=1350
RESEARCH_CHUNK_MAX_RUNES=1800
RESEARCH_CHUNK_MIN_LETTERS=120
