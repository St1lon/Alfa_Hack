{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ответ на уточняющий вопрос по готовому инсайту",
  "type": "object",
  "additionalProperties": false,
  "required": ["answer", "citations"],
  "properties": {
    "answer": { "type": "string", "minLength": 20, "maxLength": 2000 },
    "citations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "type": "string", "minLength": 3, "maxLength": 100 }
    }
  }
}
